# Copy this file to .env and fill in local values. Never commit .env.

# PostgreSQL (local Docker or Supabase)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telecom_intelligence
POSTGRES_USER=telecom
POSTGRES_PASSWORD=change_me
# Use require for Supabase, prefer for local Docker
POSTGRES_SSLMODE=prefer

# Optional: Kaggle API (used later for customer data download)
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# App
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
